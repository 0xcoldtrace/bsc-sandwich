# Copy sang .env va dien gia tri that. Khong commit .env.
PRIVATE_KEY=
BSC_HTTP=
BSC_WS=
# Optional. Rong = public mempool.
PRIVATE_TX_URL=

# Cum 5.3 (RPC pool, failover) - tuy chon, KHONG bat buoc phai dien:
# - BSC_HTTP co the la 1 URL (nhu tren) HOAC 1 chuoi NHIEU URL noi bang dau
#   phay (vd "https://a.example,https://b.example") - code tu tach.
# - Hoac dien them BSC_HTTP_2 .. BSC_HTTP_16 (moi bien 1 URL), thu theo thu tu.
# - Hoac dung BSC_HTTP_LIST=url1,url2,url3 (uu tien cao nhat neu co).
# Cung quy uoc cho BSC_WS/BSC_WS_2../BSC_WS_LIST (WSS pending-tx + heads).
# URL nao co "maxbackrun"/"fullprivacy"/"privacy" trong host se TU DONG bi
# loai khoi pool DOC (eth_call/getBlock/txpool) - do la kenh gui/private,
# khong phai dataseed doc.
# BSC_HTTP_2=
# BSC_HTTP_LIST=
# BSC_WS_2=
# BSC_WS_LIST=
